# The nanoMuse showcase — copy to .env and fill in. Never commit .env.

# ---- names -----------------------------------------------------------------------------------
# Where the phone lives. DNS: A record → this server, "DNS only". Cloudflare's proxy works too
# (Caddy trusts X-Forwarded-For from Cloudflare's ranges) but is slow from mainland China; keep
# it for emergencies. See README.
SITE_HOST=demo.nanomuse.dev
# Sessions live at <id>.<SESSION_DOMAIN>. DNS: A record for *.s.nanomuse.dev → this server,
# "DNS only" (WebSockets and the wildcard certificate terminate at Caddy).
SESSION_DOMAIN=s.nanomuse.dev
PUBLIC_SCHEME=https
# Let's Encrypt writes to this address about certificates.
ACME_EMAIL=you@example.com
# Cloudflare API token with Zone → DNS → Edit and Zone → Zone → Read on the zone. Caddy proves
# ownership of both names through DNS with it (the wildcard cannot be had any other way).
CLOUDFLARE_API_TOKEN=
# Other sites on this Caddy (README, "Other sites"): the directory their site blocks in sites.d/
# serve from, mounted at /srv/www. Default: www/ next to this file.
#WWW_ROOT=

# ---- the demo models (our key; visitors may bring their own instead) -------------------------
# 阿里云百炼, OpenAI-compatible. Two lanes, two models, the same defaults every nanoMuse client
# has: DeepSeek V4.1 Flash talks to the visitor (it reads pictures too, as do deepseek-flash
# and deepseek-v4-flash, which it serves; V4 Pro does not), Qwen 3.8 27B operates the phone.
# Empty = the default.
MAIN_PROVIDER=openai
MAIN_MODEL=deepseek-v4.1-flash
MAIN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MAIN_API_KEY=
# The model that operates the phone: many small calls with a screenshot each, so it has to take
# images. Empty = qwen3.8-27b on the main lane's host and key — a fixed default, not the chat
# model. Set these to use another model or to split the two lanes across keys or providers.
GUI_PROVIDER=
GUI_MODEL=
GUI_BASE_URL=
GUI_API_KEY=

# ---- budget ----------------------------------------------------------------------------------
# Per session (a visitor's 30 minutes):
SESSION_LLM_REQUESTS=60
SESSION_LLM_TOKENS=300000
# Per day (Asia/Shanghai), all visitors on the demo key together:
DAILY_LLM_REQUESTS=3000
DAILY_LLM_TOKENS=6000000
# A new look for a visitor's Muse ("换个形象：一只橘猫"): eight pictures, drawn with qwen-image on
# Model Studio's native API with the demo key — on by itself when MAIN_BASE_URL is a Model Studio
# host, else only with an IMAGE_MODEL here. IMAGE_MODEL= turns it off. Counted apart from the chat.
# IMAGE_MODEL=qwen-image-3.0
# IMAGE_API_KEY=                       # defaults to MAIN_API_KEY
# IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
IMAGE_PER_SESSION=12
DAILY_IMAGES=400
# …and the chosen face animated: four short clips (one per mood) with Wan on Model Studio's
# asynchronous video API, the gateway standing in for the provider's storage — on by itself when
# the pictures are, VIDEO_MODEL= turns it off. About ¥0.5 a clip at wan2.2-i2v-flash prices.
# VIDEO_MODEL=wan2.2-i2v-flash
# VIDEO_API_KEY=                       # defaults to IMAGE_API_KEY
# VIDEO_BASE_URL=https://dashscope.aliyuncs.com/api/v1
CLIPS_PER_SESSION=4
DAILY_CLIPS=120
# Visitors may use their own key (no budget then). The gateway only forwards to these hosts
# (and their subdomains); see DEFAULT_BYOK_HOSTS in gateway/showcase_gateway/config.py.
BYOK_ENABLED=1
# BYOK_ALLOWED_HOSTS=dashscope.aliyuncs.com,maas.aliyuncs.com,api.deepseek.com,api.openai.com,...

# ---- trial credentials for the phone app -----------------------------------------------------
# Off by default. On, `POST /api/trial` hands a phone a key and a model address on this gateway
# with TRIAL_TOKENS to spend, once per device, through the demo model above.
TRIAL_ENABLED=0
TRIAL_TOKENS=1000000
TRIAL_PER_IP_DAILY=5
TRIAL_DAILY_NEW=200
TRIAL_DAILY_TOKENS=20000000
TRIAL_RPM=30

# ---- nanoMuse Web: a kept Muse per Cloud account ---------------------------------------------
# Off by default. On, /web/ (put in front of it by the site's Caddy block, see mirror/) signs a
# person in to nanoMuse Cloud with an e-mail or phone code and starts them a container of their
# own — kept, with volumes, stopped after WEB_IDLE_STOP_S of quiet and woken on the next visit.
# The containers reach the relay on WEB_NETWORK (the relay's compose joins it) and spend the
# account's own allowance; the gateway meters nothing for them.
WEB_ENABLED=0
# The relay as the gateway itself calls it (sign-ins, the kept Muses' accounts). On the box
# where the relay's compose shares the edge network, use its internal address — the relay then
# sees the visitor's own address and browser in the headers the gateway forwards; through the
# public name, Caddy replaces them with the gateway's.
WEB_RELAY_URL=http://nanomuse-relay:8787
WEB_RELAY_INTERNAL_URL=http://nanomuse-relay:8787
WEB_NETWORK=nanomuse-web
WEB_MAX_ACCOUNTS=60
WEB_MAX_RUNNING=12
WEB_IDLE_STOP_S=21600
# WEB_KEY_TTL_S=2592000                             # the container's Cloud key lapses after this (30 days); then sign in again
WEB_CONTAINER_MEMORY=640m
WEB_CONTAINER_CPUS=1
# WEB_IMAGE=ghcr.io/nano-muse/nanomuse:latest       # defaults to NANOMUSE_IMAGE
# WEB_SLUG_SALT=change-me                            # the account hosts are an HMAC of the id

# ---- the visitors: a sign-in before a demo ---------------------------------------------------
# On by default: a visitor signs in to nanoMuse Cloud (a code to a phone or an inbox, or the
# account's password — the relay at WEB_RELAY_URL) before the phone starts a demo Muse, so the
# project knows who is trying it; a first sign-in creates the account, with its free allowance,
# for the day the person installs the app. The gateway keeps the account id and the relay's
# masked identifier (never the identifier itself) in VISITOR_DB and hands the browser a ticket
# good for VISITOR_TTL_S. The demo still talks to the showcase's model, not to the account's
# allowance. 0 turns it off: a visitor is a visitor, counted by address only.
DEMO_SIGNIN_REQUIRED=1
PER_ACCOUNT_ACTIVE=1
# Starts an account gets in any 24 hours: a rolling window from each start, in the visitor's
# own time wherever they are, not a calendar day in one time zone. A start the box failed to
# bring up is not counted.
PER_ACCOUNT_DAILY=6
VISITOR_DB=/data/visitors.db
VISITOR_TTL_S=2592000
# The operator's view of the visitors — where from, with what browser, every demo and what it
# used — at GET /api/demo/admin with this token in X-Admin-Token; the relay's admin page reads
# it (WEB_ADMIN_URL=https://demo.nanomuse.dev/api/demo/admin, WEB_ADMIN_TOKEN=the same value).
# Empty: the route does not exist.
SHOWCASE_ADMIN_TOKEN=

# ---- sessions --------------------------------------------------------------------------------
SESSION_TTL_S=1800
IDLE_TTL_S=600
MAX_SESSIONS=20
PER_IP_ACTIVE=1
# Starts an address gets in any 24 hours (the same rolling window as PER_ACCOUNT_DAILY).
PER_IP_DAILY=6
START_TIMEOUT_S=40

# ---- the containers --------------------------------------------------------------------------
# :latest is the last release, :edge is main.
NANOMUSE_IMAGE=ghcr.io/nano-muse/nanomuse:latest
CONTAINER_MEMORY=512m
CONTAINER_CPUS=1
CONTAINER_PIDS=256
# Extra environment for every session, comma separated, e.g. NANOMUSE_SENTINEL_MODE=ask
# SESSION_EXTRA_ENV=

# ---- images ----------------------------------------------------------------------------------
# Caddy (with the built phone inside) and the gateway are published by .github/workflows/showcase.yml;
# `docker compose pull` gets them. To build them here instead: `docker compose build`, with
# the two settings below saying which tag to name the images and which MobileGym to put in.
SHOWCASE_TAG=latest
# Which MobileGym to build the phone from. Empty or unset = the commit pinned in mobilegym.ref,
# the one the showcase was tested with; a branch, tag or commit id here overrides it for a build
# on this box (README, "Bumping MobileGym").
# MOBILEGYM_REF=
# Whose X-Forwarded-For names the visitor: the edge proxy, as addresses, networks or the compose
# service name. The default is Caddy in this compose file; a different front needs its address
# here, and "*" (any peer) lets a session container choose the address it is limited under.
# TRUSTED_PROXIES=caddy
# Go module mirror for compiling Caddy; on a mainland network use https://goproxy.cn,direct
# GOPROXY=https://proxy.golang.org,direct
