/* Siri invocation phrases for MinisShortcutsProvider (AppShortcuts), Korean.
   Keys must match the English phrases exactly, with `\(.applicationName)`
   spelled `${applicationName}`. Legacy .strings format (not .xcstrings)
   because the deployment target is iOS 16. */

"Ask ${applicationName}" = "${applicationName}에게 물어보기";
"Ask ${applicationName} a question" = "${applicationName}에게 질문하기";
"Talk to ${applicationName}" = "${applicationName}와 대화하기";
"New ${applicationName} chat" = "${applicationName} 새 채팅";
"Run a ${applicationName} quick task" = "${applicationName} 빠른 작업 실행";
"Use ${applicationName} quick task" = "${applicationName} 빠른 작업 사용";
"Send a prompt to ${applicationName}" = "${applicationName}에 프롬프트 보내기";
"Ask ${applicationName} something" = "${applicationName}에게 뭔가 물어보기";
"Start a ${applicationName} task" = "${applicationName} 작업 시작";
"Get ${applicationName} session status" = "${applicationName} 세션 상태 확인";
"Check ${applicationName} task" = "${applicationName} 작업 확인";
"List ${applicationName} sessions" = "${applicationName} 세션 목록";
"Show ${applicationName} chats" = "${applicationName} 채팅 보기";
"Follow up a ${applicationName} session" = "${applicationName} 세션 이어가기";
"Continue a ${applicationName} session" = "${applicationName} 세션 계속하기";
"Open a ${applicationName} session" = "${applicationName} 세션 열기";

"Voice prompt to ${applicationName}" = "${applicationName}에 음성으로 입력";
"Talk to ${applicationName} by voice" = "${applicationName}에게 음성으로 말하기";
