        "single_submission"
      ],
      "name_zh": "同一唤醒事件重复送达",
      "gold_rationale_zh": "固定事件历史记载同一唤醒事件投递两次，fixture宿主只执行一次，服务接受且总提交数为一。未测试或声称生产Scheduler具备去重。"
    }
  ],
  "contract": {
    "goal_id": "goal:weekly-report",
    "revision": 1,
    "criteria": [
      {
        "id": "report_valid",
        "subject": "fixture://weekly-report/report.json",
        "metric": "report_valid",
        "op": "eq",
        "target": true,
        "unit": "boolean",
        "collectors": [
          "fixture.business.v1"
        ],
        "max_age": 60,
        "invariant": false
      },
      {
        "id": "accepted",
        "subject": "fixture://submission/current",
        "metric": "accepted",
        "op": "eq",
        "target": true,
        "unit": "boolean",
        "collectors": [
          "fixture.business.v1"
        ],
        "max_age": 60,
        "invariant": false
      },
      {
        "id": "window_open",
        "subject": "fixture://submission/window",
        "metric": "window_open",
        "op": "eq",
        "target": true,
        "unit": "boolean",
        "collectors": [
          "fixture.business.v1"
        ],
        "max_age": 60,
        "invariant": true
      },
      {
        "id": "single_submission",
        "subject": "fixture://submission/count",
        "metric": "single_submission",
        "op": "eq",
        "target": true,
        "unit": "boolean",
        "collectors": [
          "fixture.business.v1"
        ],
        "max_age": 60,
        "invariant": true
      }
    ]
  },
  "schema_version": 1,
  "title_zh": "离线 GoalEval 固定回归集"
}
